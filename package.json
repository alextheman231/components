{
  "name": "@alextheman/components",
  "version": "7.12.3",
  "description": "A package containing common React components used across my projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alextheman231/components.git"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "alextheman",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./DropdownMenu": {
      "types": "./dist/DropdownMenu/index.d.ts",
      "import": "./dist/DropdownMenu/index.js"
    },
    "./QueryBoundary": {
      "types": "./dist/QueryBoundary/index.d.ts",
      "import": "./dist/QueryBoundary/index.js"
    },
    "./Tab": {
      "types": "./dist/Tab/index.d.ts",
      "import": "./dist/Tab/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js"
    },
    "./file": {
      "types": "./dist/file/index.d.ts",
      "import": "./dist/file/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "import": "./dist/routing/index.js"
    },
    "./snackbar": {
      "types": "./dist/snackbar/index.d.ts",
      "import": "./dist/snackbar/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./v8/theme": {
      "types": "./dist/v8/theme/index.d.ts",
      "import": "./dist/v8/theme/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "create-feature-docs": "storybook build",
    "create-local-package": "pnpm run build && rm -f alextheman-components-*.tgz && pnpm pack",
    "create-release": "bash -c 'git pull origin main && alex-c-line template release-note create $@ --status \"Released\" --update-version' --",
    "create-release-note": "git pull origin main && bash -c 'alex-c-line template release-note create $@' --",
    "format": "pnpm run format-oxlint && pnpm run format-oxfmt && pnpm run format-markdownlint",
    "format-oxlint": "oxlint --fix",
    "format-markdownlint": "markdownlint-cli2 --fix \"**/*.md\" \"!{node_modules,dist}/**\" | grep -v \"^Finding:\"",
    "format-oxfmt": "oxfmt \"./**/*.{ts,tsx,js,yml,yaml}\"",
    "lint": "pnpm run lint-tsc && pnpm run lint-oxlint && pnpm run lint-markdownlint && pnpm run lint-oxfmt && pnpm run lint-pre-release",
    "lint-oxlint": "oxlint",
    "lint-markdownlint": "bash -o pipefail -c 'markdownlint-cli2 \"**/*.md\" \"!{node_modules,dist}/**\"| grep -v \"^Finding:\"'",
    "lint-oxfmt": "oxfmt --check \"./**/*.{ts,tsx,js,yml,yaml}\"",
    "lint-pre-release": "alex-c-line package-json check --rules no-pre-release-dependencies",
    "lint-tsc": "tsc --noEmit",
    "pre-commit": "alex-c-line pre-commit",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test-end-to-end": "playwright test",
    "test-update-ci-snapshots": "docker run --rm -it -v \"$PWD\":/work -v \"$HOME/.pnpm-store\":/pnpm-store -w /work mcr.microsoft.com/playwright:v1.58.2-jammy bash -lc \"npm i -g pnpm@10.29.3 && pnpm config set store-dir /pnpm-store && pnpm install && pnpm test-update-snapshots\"",
    "test-update-snapshots": "playwright test --update-snapshots",
    "update-dependencies": "pnpm update --latest && pnpm update"
  },
  "dependencies": {
    "@alextheman/utility": "5.32.2",
    "common-tags": "1.8.2",
    "date-fns": "4.4.0",
    "react-icons": "5.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@alextheman/configs": "1.5.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "@mui/x-date-pickers": "9.18.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@tanstack/react-form": "1.33.5",
    "@types/common-tags": "1.8.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/types": "8.73.0",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "alex-c-line": "2.18.3",
    "dotenv-cli": "11.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "execa": "10.2.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.24.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "19.3.1",
    "storybook": "10.6.8",
    "styled-components": "6.6.0",
    "tempy": "3.2.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "5.1.1",
    "wouter": "3.13.0"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.0.0",
    "@emotion/styled": ">=11.0.0",
    "@mui/material": ">=7.0.0",
    "@mui/x-date-pickers": "9.13.0",
    "@tanstack/react-form": ">=1.28.5",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "wouter": ">=3.9.0"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "engines": {
    "node": ">=22.0.0"
  }
}
